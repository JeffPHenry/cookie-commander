{
  "manifest_version": 3,
  "name": "Cookie Commander",
  "version": "1.5.0",
  "description": "Antivirus for your browser's cookies. See every tracker auctioning your attention in real time \u2014 and shut them all down. 100% local.",
  "permissions": [
    "cookies",
    "history",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open Cookie Commander",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
